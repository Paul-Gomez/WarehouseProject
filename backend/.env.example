# Copia este archivo a .env y ajusta los valores.

# Puerto en el que escucha la API
PORT=3000

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Cadena de conexión a PostgreSQL (se usará a partir de la Fase 1 con Prisma)
DATABASE_URL="postgresql://warehouseproject:warehouseproject@localhost:5432/warehouseproject?schema=public"

# Secretos de JWT. Genera los tuyos con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nunca reutilices los mismos valores entre entornos ni los subas a git (.env está en .gitignore).
JWT_ACCESS_SECRET="cambia-este-valor-por-uno-aleatorio-de-al-menos-32-caracteres"
JWT_REFRESH_SECRET="cambia-este-otro-valor-tambien-de-al-menos-32-caracteres"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Facturación: IVA que se aplica a las facturas nuevas (%) y días hasta el vencimiento
IVA_PORCENTAJE=21
FACTURA_DIAS_VENCIMIENTO=30

# Solo si el frontend se sirve desde otro dominio (p. ej. https://mi-app.vercel.app).
# Varios orígenes separados por comas. Vacío = mismo origen.
CORS_ORIGIN=

# Proxies delante de la API (0 en local; 1 detrás de nginx o de Render)
TRUST_PROXY=0

# Datos del emisor que aparecen en el PDF de las facturas
EMPRESA_NOMBRE="WarehouseProject S.L."
EMPRESA_NIF=B00000000
EMPRESA_DIRECCION="Calle Ejemplo 1, 28001 Madrid"
