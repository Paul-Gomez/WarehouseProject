# Copia este archivo a .env y ajusta los valores.

# Puerto en el que escucha la API
PORT=3000

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Cadena de conexión a PostgreSQL (se usará a partir de la Fase 1 con Prisma)
DATABASE_URL="postgresql://almacenproyecto:almacenproyecto@localhost:5432/almacenproyecto?schema=public"
